# Supabase PostgreSQL Connection String (Transaction Pooler - Port 6543)
DATABASE_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"

# Direct Connection String (Port 5432 - for migrations and Prisma direct access)
DIRECT_URL="postgresql://postgres:[PASSWORD]@db.[PROJECT_REF].supabase.co:5432/postgres"

# Optional: Set this only if frontend is hosted on a different domain than backend API
# If hosted together (e.g. Vercel), leave empty for relative /api routing
NEXT_PUBLIC_API_URL=""

# JWT Authentication
JWT_SECRET_KEY="your-jwt-secret-key-change-in-production"
