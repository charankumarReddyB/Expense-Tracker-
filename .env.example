# Smart Expense Tracking System - Environment Variables Template
# Copy this file to .env and fill in your actual values

# ============================================
# DATABASE CONFIGURATION
# ============================================
# Local PostgreSQL Connection (Development)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/expense_tracker

# Alternative: Supabase PostgreSQL (Production)
# DATABASE_URL=postgresql://user:password@host:5432/database_name
# Example: postgresql://postgres:yourpassword@db.xxxxx.supabase.co:5432/postgres

# ============================================
# AUTHENTICATION & SECURITY
# ============================================
# JWT Secret Key (generate with: openssl rand -hex 32)
JWT_SECRET_KEY=your-secret-key-here-change-this-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# Password Hashing (bcrypt cost factor)
BCRYPT_COST_FACTOR=12

# ============================================
# AI/ML CONFIGURATION
# ============================================
# OpenAI API Key (for conversational AI and advanced NLP)
OPENAI_API_KEY=sk-your-openai-api-key-here

# Hugging Face API Token (for transformer models)
HUGGINGFACE_API_TOKEN=hf_your-huggingface-token-here

# ML Model Paths (relative to backend directory)
ML_MODELS_PATH=ml/models/
ML_CATEGORIZER_MODEL=categorizer_v1.pkl
ML_FRAUD_DETECTOR_MODEL=fraud_detector_v1.pkl
ML_BUDGET_PREDICTOR_MODEL=budget_predictor_v1.pkl

# Model Training Configuration
ML_CATEGORIZATION_CONFIDENCE_THRESHOLD=0.7
ML_FRAUD_DETECTION_THRESHOLD=0.85
ML_RETRAIN_SCHEDULE_DAYS=7

# ============================================
# PAYMENT PLATFORM INTEGRATION
# ============================================
# Mock Platform Settings (for development)
USE_MOCK_PLATFORMS=true
MOCK_DATA_GENERATION_ENABLED=true

# Real Platform OAuth (for production - leave empty if using mock)
UPI_CLIENT_ID=
UPI_CLIENT_SECRET=
UPI_REDIRECT_URI=

BANKING_API_KEY=
BANKING_API_SECRET=

WALLET_API_KEY=
WALLET_API_SECRET=

# ============================================
# NOTIFICATION SERVICES
# ============================================
# Email Configuration (SMTP)
EMAIL_ENABLED=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-specific-password
EMAIL_FROM=noreply@expensetracker.com

# Push Notifications (optional)
PUSH_NOTIFICATIONS_ENABLED=false
FIREBASE_CREDENTIALS_PATH=

# ============================================
# API CONFIGURATION
# ============================================
# CORS Settings (comma-separated origins)
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# API Rate Limiting
RATE_LIMIT_PER_MINUTE=100
RATE_LIMIT_PER_HOUR=1000

# API Documentation
API_DOCS_ENABLED=true
API_TITLE=Smart Expense Tracker API
API_VERSION=1.0.0

# ============================================
# APPLICATION SETTINGS
# ============================================
# Environment
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO

# Data Retention
DATA_RETENTION_YEARS=2
AUTO_ARCHIVE_ENABLED=true

# Timezone
DEFAULT_TIMEZONE=Asia/Kolkata
DEFAULT_CURRENCY=INR

# ============================================
# FRONTEND CONFIGURATION
# ============================================
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_APP_NAME=Smart Expense Tracker
NEXT_PUBLIC_THEME=dark

# ============================================
# TEMPORARY FILE STORAGE
# ============================================
TEMP_DIR=.tmp/
MAX_UPLOAD_SIZE_MB=10

# ============================================
# MONITORING & LOGGING
# ============================================
# Sentry (Error Tracking)
SENTRY_DSN=
SENTRY_ENVIRONMENT=development

# Analytics
ANALYTICS_ENABLED=false
ANALYTICS_TRACKING_ID=

# ============================================
# TESTING
# ============================================
TEST_DATABASE_URL=postgresql://localhost:5432/expense_tracker_test
TEST_MODE=false
